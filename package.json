{
  "name": "business-review-360",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --config=testing/playwright.config.js",
    "test:headed": "playwright test --config=testing/playwright.config.js --headed",
    "test:ui": "playwright test --config=testing/playwright.config.js --ui",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.integration.js",
    "test:integration:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.integration.js --runInBand",
    "test:e2e:smoke": "playwright test --config=testing/playwright.config.js testing/e2e/00-basic-smoke.spec.js testing/e2e/02-idea-management.spec.js testing/e2e/06-security-authorization.spec.js testing/e2e/19-ideas-pagination.spec.js"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@testcontainers/postgresql": "^12.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "sequelize": "^6.37.8",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1"
  }
}
