# Package managers alternative files
bun.lockb
# Root pnpm-lock.yaml is intentionally NOT ignored: pnpm is the canonical
# package manager and the root lockfile is the single source of truth.
# Per-package lockfiles ARE ignored: backend/ and frontend/ each carry a
# tracked stripped pnpm-workspace.yaml for the Docker build (#846), which
# makes any pnpm command run from those dirs treat them as a separate
# workspace root and emit a stray local lockfile. These must never be
# committed; they would shadow the root lockfile.
backend/pnpm-lock.yaml
frontend/pnpm-lock.yaml

