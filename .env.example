# Business Review 360 - Environment Configuration Template
#
# DEVELOPMENT: Copy this file to .env and fill in your values
# PRODUCTION: Use production values (see comments for differences)
#
# IMPORTANT: Do NOT use inline comments in .env files!
# Comments must be on their own line, like this file demonstrates.

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Application Database (Tenant Data)
# IMPORTANT (Issue #542): any of these characters in POSTGRES_PASSWORD must be
# URL-encoded when building DATABASE_URL: @ : / ? # [ ]
# Encode: @ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23, [ -> %5B, ] -> %5D
# Safer still: generate passwords that avoid URL-reserved characters entirely.
# A literal @ in the password produces "@@" in the URL and breaks strict URL
# parsers (including Azure Database for PostgreSQL migration tooling).
POSTGRES_USER=business_review_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=business_review_db
DATABASE_URL=postgres://business_review_user:change_this_password@db:5432/business_review_db

# Platform Database (Control Plane - Billing & Tenancy)
# Same URL-encoding rule applies (see above).
PLATFORM_DATABASE_URL=postgres://business_review_user:change_this_password@db:5432/br360_platform

# Constrained role for route-path RLS enforcement (Issue #740 / PR #742).
# When set, wrapTenantTransaction does SET LOCAL ROLE <APP_DB_ROLE> inside
# each request transaction so RLS applies (the login user has SUPERUSER+
# BYPASSRLS so cron jobs can iterate across tenants without SET app.tenant_id
# boilerplate; the role-switch constrains routes only). Create the role via
# db/patches/740-app-db-role.sql before setting this. Leave unset in local
# dev where the role does not exist; the wrapper falls back to today's
# behaviour (SET LOCAL app.tenant_id only, RLS bypassed by login user).
APP_DB_ROLE=br360_app_user

# Legacy database variables (for backwards compatibility)
DB_USERNAME=business_review_user
DB_PASSWORD=change_this_password
DB_DATABASE=business_review_db
DB_HOST=db
DB_PORT=5432

# ==============================================
# JWT CONFIGURATION
# ==============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_characters_required
JWT_EXPIRATION=7d

# ==============================================
# SERVER CONFIGURATION
# ==============================================
PORT=4000
# PRODUCTION: Use "production"
NODE_ENV=development
# PRODUCTION: Use https://br360.example.com
FRONTEND_URL=http://localhost:3000

# ==============================================
# RECAPTCHA CONFIGURATION
# ==============================================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Choose ONE of the following email providers:

# Option 1: Resend (Recommended for production)
# Sign up at https://resend.com, verify your sending domain, then create an
# API key at https://resend.com/api-keys.
RESEND_API_KEY=re_your_resend_api_key_here

# From: address used for all outbound transactional email. Must be on a
# domain you have verified in Resend. Used by both the email-template
# pipeline and the password-reset / verification flows.
EMAIL_FROM=auth@yourdomain.com

# Display name for the From header (issue #645). When set, emails go out as
# "Business Review 360 <auth@yourdomain.com>" instead of just the bare
# address. Improves recognisability in inboxes. The address itself still has
# to be on a Resend-verified domain.
EMAIL_FROM_NAME=Business Review 360

# Destination inbox for sales-enquiry notifications (issue #509).
# Falls back to EMAIL_FROM if unset.
SALES_NOTIFICATION_EMAIL=sales@yourdomain.com

# Customer-facing support address shown in transactional emails
# (e.g. subscription cancellation). Falls back to EMAIL_FROM if unset.
SUPPORT_EMAIL=support@yourdomain.com

# Destination inbox for demo lead-capture notifications (#566).
# When set, a notification email fires whenever a visitor submits their
# email address on the /demo page. Leave unset to disable lead capture.
LEAD_CAPTURE_EMAIL=leads@yourdomain.com

# Option 2: Gmail App Password (Good for development/small scale)
# Generate app password at https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password

# Legacy email configuration (deprecated - use Resend or Gmail instead)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# OAuth (Optional - Only if you need to READ emails, not just send)
# GMAIL_CLIENT_ID=your_google_oauth_client_id
# GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token

# ==============================================
# ADMIN CONFIGURATION
# ==============================================
ADMIN_RECOVERY_EMAIL=your_email@gmail.com

# ==============================================
# RATE LIMITING CONFIGURATION
# ==============================================
# DEV: Override to "true" only if rate limits interfere with local testing
DISABLE_RATE_LIMIT=false

# ==============================================
# TEST-ONLY DESTRUCTIVE ENDPOINTS (Issue #544)
# ==============================================
# Set to "true" ONLY on dev/CI boxes that run the Playwright suite. When
# "true" the backend mounts POST /api/setup/reset-database, which wipes all
# Votes/Comments/Ideas/Users for the active tenant database. The route is
# additionally gated by a per-boot bearer token written to
# backend/.test-reset-token (gitignored). Must never be "true" in production.
ALLOW_DESTRUCTIVE_TEST_ENDPOINTS=false

# ==============================================
# LOGGING CONFIGURATION (Issue #334)
# ==============================================
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
# PRODUCTION: Use "true" for request logging
LOG_HTTP_REQUESTS=false
# Note: Logs are output as JSON for production parsing

# ==============================================
# AUDIT LOGGING (Issues #338, #127, #586, #588, #589, #590)
# ==============================================
# Enable audit trail for security compliance. Setting to 'false' is
# the kill switch: writes via auditLogger middleware AND logAuditEvent
# manual calls are halted, AND the retention prune cron is paused.
ENABLE_AUDIT_LOGGING=true

# Enable support mode with read-only access
ENABLE_SUPPORT_MODE=false
# Note: Support users are identified by role='support' or email domain '@support.'

# Audit log retention (#590). Rows older than this are hard-deleted
# by a daily cron. Default 90 days. Bad input falls back to 90.
AUDIT_LOG_RETENTION_DAYS=90

# Cron schedule for the prune job. Default: 03:00 UTC daily.
AUDIT_LOG_PRUNE_CRON=0 3 * * *

# Independent on/off for the prune cron (separate from
# ENABLE_AUDIT_LOGGING above). Defaults to NODE_ENV=production:
# auto-on in prod, auto-off in dev/test. Set explicitly to 'true' or
# 'false' to override.
AUDIT_LOG_PRUNE_ENABLED=true

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
VITE_API_URL=/api
# PRODUCTION: Set to actual build version
VITE_BUILD_NUMBER=dev
VITE_ADMIN_EMAIL=your_email@gmail.com

# Feature flag for the social-proof components (TestimonialStrip, LogoCloud).
# Falsy (false/0/unset) renders muted placeholders. Flip to "true" once real
# testimonials and customer logos are available. See issue #533.
# Note: this var must also be whitelisted in frontend/vite.config.js `define`
# block for it to reach the browser at runtime.
VITE_SHOW_SOCIAL_PROOF=false

# ==============================================
# GITHUB INTEGRATION
# ==============================================
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name

# ==============================================
# OAUTH SOCIAL LOGIN (GitHub, Google, Microsoft)
# ==============================================
# GitHub OAuth app (also used for admin console login at admin.br360.example.com).
# Create at: https://github.com/settings/applications/new
# Authorization callback URL: https://br360.example.com/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Google OAuth app (optional — enables Google sign-in for tenants).
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Microsoft/Azure AD OAuth app (optional — enables Microsoft SSO for tenants).
MICROSOFT_CLIENT_ID=your_microsoft_oauth_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_oauth_client_secret

# Base URL used to build OAuth redirect URIs (OAUTH_CALLBACK_BASE_URL + /api/auth/oauth/:provider/callback).
# PRODUCTION: https://br360.example.com
# Must match the callback URL registered in each provider's OAuth app settings.
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# Admin console URL (admin.br360.example.com). Used to redirect back after admin
# OAuth login. If unset, computed from FRONTEND_URL by prefixing "admin." to
# the host (br360.example.com has no www host to substitute any more).
ADMIN_URL=https://admin.br360.example.com

# ==============================================
# STRIPE BILLING CONFIGURATION
# ==============================================
# Stripe API Keys
# PRODUCTION: Use sk_live_... and pk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe Webhook Secret (for verifying webhook signatures)
# Get from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (AUD pricing)
# SME Plan: $19.95/month or $203.50/year (15% discount)
STRIPE_PRICE_SME_MONTH=price_your_sme_monthly_price_id
STRIPE_PRICE_SME_YEAR=price_your_sme_yearly_price_id

# Pro Plan: $49.95/month or $509.40/year (15% discount)
STRIPE_PRICE_PRO_MONTH=price_your_pro_monthly_price_id
STRIPE_PRICE_PRO_YEAR=price_your_pro_yearly_price_id

# Enterprise Plan: $249.00/month or $2,539.80/year (15% discount)
STRIPE_PRICE_ENT_MONTH=price_your_enterprise_monthly_price_id
STRIPE_PRICE_ENT_YEAR=price_your_enterprise_yearly_price_id

# Note: Stripe Tax will be enabled in a future milestone for AU GST compliance
# See docs/STRIPE_TAX_SETUP.md for details

# ==============================================
# DIGEST EMAIL CONFIGURATION (Issue #444)
# ==============================================
# Set to "true" to enable scheduled digest sends (weekly/monthly/quarterly
# summaries, re-engagement, satisfaction surveys, hourly/daily/weekly
# batchDigestEmails). Does NOT gate the queue worker any more (see #747);
# transactional sends route through the queue regardless of this value.
DIGEST_ENABLED=false
# Timezone for sending digests (e.g., Australia/Brisbane, America/New_York)
DIGEST_TIMEZONE=America/New_York
# Hour to send weekly digest (0-23)
WEEKLY_DIGEST_HOUR=9
# Hour to send monthly/quarterly digests (0-23)
MONTHLY_DIGEST_HOUR=9
# Note: Weekly = Monday at 9 AM, Monthly = 1st of month, Quarterly = Jan/Apr/Jul/Oct 1st

# ==============================================
# EMAIL QUEUE CONFIGURATION (Issue #446, #747)
# ==============================================
# Queue worker (processQueue + queueCleanup + healthMonitor +
# analyticsAggregation + logCleanup) is always-on at backend startup
# regardless of DIGEST_ENABLED. See backend/src/jobs/emailQueueWorker.js.
#
# Optional: override the timezone used for the worker's scheduled crons.
# Falls back to DIGEST_TIMEZONE, then UTC.
# EMAIL_QUEUE_TIMEZONE=Australia/Brisbane
#
# Number of emails to process per batch
EMAIL_QUEUE_BATCH_SIZE=50
# Maximum retry attempts for failed emails
EMAIL_QUEUE_MAX_RETRIES=3
# Maximum emails per hour
EMAIL_QUEUE_RATE_LIMIT=1000
# Days to keep sent/failed entries
EMAIL_QUEUE_CLEANUP_DAYS=30
# Days to keep email logs
EMAIL_LOG_RETENTION_DAYS=90

# ==============================================
# OPS METRICS DASHBOARD (Issue #848)
# ==============================================
# Sampler (EmailQueue pending/failed counts, every 5 min) + prune
# (ErrorEvents/MetricsSamples older than 90 days, daily) are always-on at
# backend startup. See backend/src/jobs/opsMetricsJob.js.
#
# Optional: override the timezone used for both crons. Defaults to UTC.
# OPS_METRICS_TIMEZONE=Australia/Brisbane

# ==============================================
# EMAIL ANALYTICS THRESHOLDS (Issue #448)
# ==============================================
# Critical alerts (immediate action needed)
# Critical if bounce rate >= 10%
EMAIL_BOUNCE_RATE_CRITICAL=10
# Critical if spam rate >= 0.1%
EMAIL_SPAM_RATE_CRITICAL=0.1
# Critical if delivery rate < 90%
EMAIL_DELIVERY_RATE_CRITICAL=90

# Warning alerts (monitor closely)
# Warning if bounce rate >= 5%
EMAIL_BOUNCE_RATE_WARNING=5
# Warning if unsubscribe rate >= 2%
EMAIL_UNSUBSCRIBE_RATE_WARNING=2
# Warning if open rate < 20%
EMAIL_OPEN_RATE_WARNING=20
# Warning if delivery rate < 95%
EMAIL_DELIVERY_RATE_WARNING=95

# ==============================================
# AI INTEGRATION (#721)
# ==============================================
# Encryption key for storing tenant BYO API keys at rest.
# Must be exactly 32 bytes (64 hex chars). Generate with: openssl rand -hex 32
# Required for BYO mode to work; leave blank to disable BYO key storage.
AI_ENCRYPTION_KEY=

# BR360 managed AI credentials (used when tenant selects "managed" mode).
# Leave blank if you are not offering managed AI to tenants.
BR360_AI_PROVIDER=anthropic
BR360_AI_API_KEY=

# ==============================================
# LIGHTHOUSE TESTING
# ==============================================
# JWT token for authenticated Lighthouse scans
# Get this by logging into your production site and copying the token from localStorage
LIGHTHOUSE_JWT_TOKEN=your_jwt_token_from_production

# ---------------------------------------------------------------------------
# GlitchTip / Sentry error tracking (https://glitchtip.example.com)
# Same project DSN for backend (SENTRY_DSN) and frontend (VITE_SENTRY_DSN,
# baked in at build time). Leave blank to disable.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
VITE_SENTRY_DSN=
