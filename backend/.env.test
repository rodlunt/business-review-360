# Test-only environment variables for backend Jest runs.
#
# Tracked in git on purpose. All values are dummies. Real secrets must NEVER
# land in this file. See docs/superpowers/specs/2026-04-26-593-env-leak-test-isolation-design.md
#
# Loaded by backend/jest.setup.js before any test module resolves. The setup
# file also asserts that DATABASE_URL is sqlite::memory: or a localhost
# Postgres URL so a leaked prod-shaped value aborts the run loudly.

NODE_ENV=test

# Database URLs default to SQLite in-memory. Integration suites that need a
# real Postgres testcontainer override these per-suite in beforeAll (see #591).
DATABASE_URL=sqlite::memory:
PLATFORM_DATABASE_URL=sqlite::memory:

# JWT: long enough to pass the 32-char minimum-length check in index.js.
JWT_SECRET=test-jwt-secret-do-not-use-in-prod-please
JWT_EXPIRES_IN=1h

# Mailer: every test mocks the mailer module via jest.unstable_mockModule. The
# empty key exercises the no-provider-configured branch if the mock is missed.
RESEND_API_KEY=
EMAIL_FROM=auth@test.invalid

# Stripe: SDK accepts the sk_test_ prefix at construction time. Tests that hit
# Stripe must mock the SDK; an unmocked test fails loudly on the first call.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_test_dummy

# Resend webhook (Issue #572). The Svix-compatible verifier base64-decodes the
# secret after stripping any `whsec_` prefix; this dummy decodes to predictable
# bytes the test suite signs against.
RESEND_WEBHOOK_SECRET=whsec_dGVzdC1yZXNlbmQtd2ViaG9vay1zZWNyZXQ=

# reCAPTCHA: middleware must be mocked or skipped in tests.
RECAPTCHA_SECRET_KEY=test-recaptcha-secret

# Issue #878: e2e test-mode bypass token for the recaptcha verifier. When
# the incoming token equals this value, verifyRecaptcha returns a synthetic
# success. PRODUCTION SAFETY: this env var must NEVER be set in any prod
# environment. deploy-production.yml does not pass it through; the server
# .env must not include it. verifyRecaptcha emits logger.warn on every
# bypass so a leak is immediately visible.
RECAPTCHA_E2E_BYPASS_TOKEN=e2e-test-recaptcha-token-do-not-use-in-prod

# Rate limiting: disabled so multi-request test suites don't self-throttle.
DISABLE_RATE_LIMIT=true

# Demo lead capture inbox.
LEAD_CAPTURE_EMAIL=leads@test.invalid

# URLs: used in CORS and email link generation. Localhost only.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Listen port. Tests do not bind a real server.
PORT=4000

# Quieten noisy modules and disable audit-log writes during tests.
LOG_LEVEL=error
ENABLE_AUDIT_LOGGING=false
